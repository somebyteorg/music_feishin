/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "emos-music-feishin",
    "compatibility_date": "2026-05-26",
    "assets": {
        "not_found_handling": "single-page-application",
        "directory": "./out/web"
    },
    "observability": {
        "logs": {
            "enabled": false
        },
        "traces": {
            "enabled": false
        }
    },
    "routes": [
        {
            "pattern": "music.emos.best/",
            "zone_name": "emos.best"
        },
        {
            // emos link 回调用
            "pattern": "music.emos.best/feishin*",
            "zone_name": "emos.best"
        },
        {
            "pattern": "music.emos.best/favicon*",
            "zone_name": "emos.best"
        },
        {
            "pattern": "music.emos.best/robots.txt",
            "zone_name": "emos.best"
        },
        {
            "pattern": "music.emos.best/assets/*",
            "zone_name": "emos.best"
        }
    ]
}